# Frontend-safe values only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_AI_API_URL=http://localhost:8000
NEXT_PUBLIC_PERSISTENCE_ENABLED=false

# AI server only
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:3000
GIT_COMMIT_SHA=
HYPERFUSION_PROFILE=calibration_v1

# Foundation-model inference endpoints.
# Each endpoint must expose POST /infer and return real_inference=true.
TERRAMIND_INFERENCE_URL=
TERRAMIND_CHECKPOINT=
PRITHVI_INFERENCE_URL=
PRITHVI_CHECKPOINT=
DINOV3_SAT_INFERENCE_URL=
DINOV3_SAT_CHECKPOINT=facebook/dinov3-vitl16-pretrain-sat493m
SAM31_INFERENCE_URL=
SAM31_CHECKPOINT=
SPECTRALEARTH_INFERENCE_URL=
SPECTRALEARTH_CHECKPOINT=
TERRAFLOW_INFERENCE_URL=
TERRAFLOW_CHECKPOINT=
OLMOEARTH_INFERENCE_URL=
PHYSICS_SAR_INFERENCE_URL=
PHYSICS_SAR_CHECKPOINT=
THERMAL_INERTIA_INFERENCE_URL=
THERMAL_INERTIA_CHECKPOINT=

# Foundation worker
HORUS_MODEL_KEY=dinov3_satellite
HORUS_DINOV3_MODEL_ID=facebook/dinov3-vitl16-pretrain-sat493m
HORUS_ALLOW_CPU_FOUNDATION=0

# Optional worker plugins for models that require their native runtime.
HORUS_PLUGIN_MODULE_TERRAMIND=
HORUS_PLUGIN_MODULE_PRITHVI_EO_2=
HORUS_PLUGIN_MODULE_SPECTRALEARTH_FM=
HORUS_PLUGIN_MODULE_TERRAFLOW=
HORUS_PLUGIN_MODULE_OLMOEARTH=
HORUS_PLUGIN_MODULE_PHYSICS_SAR=
HORUS_PLUGIN_MODULE_THERMAL_INERTIA=
HORUS_PLUGIN_MODULE_SAM3_1=

# Data access
EARTHDATA_TOKEN=

# Never commit real secret/service-role values or model access tokens.

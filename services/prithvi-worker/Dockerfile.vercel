FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
      fastapi==0.121.0 \
      "uvicorn[standard]==0.38.0" \
      httpx==0.28.1 \
      numpy==2.3.4 \
      onnxruntime==1.31.0 \
      pydantic==2.12.4

COPY app ./app

ENV PYTHONUNBUFFERED=1

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]

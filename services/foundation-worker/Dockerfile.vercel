FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.10.0 \
    && pip install --no-cache-dir \
      fastapi==0.121.0 \
      "uvicorn[standard]==0.38.0" \
      httpx==0.28.1 \
      numpy==2.3.4 \
      pillow==12.0.0 \
      transformers==5.20.2

COPY worker ./worker

ENV PYTHONUNBUFFERED=1
ENV HORUS_MODEL_KEY=dinov3_satellite
ENV HORUS_ALLOW_CPU_FOUNDATION=1

CMD ["sh", "-c", "uvicorn worker.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
